{
  "name": "jarvis-claude",
  "version": "1.0.0",
  "description": "Interface vocale J.A.R.V.I.S. alimentée par Claude AI et ElevenLabs",
  "main": "main.js",
  "scripts": {
    "postinstall": "node scripts/generate-icon.js",
    "start": "electron .",
    "dev": "ELECTRON_ENABLE_LOGGING=1 electron .",
    "build": "electron-builder --mac dmg"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.jarvis.claude",
    "productName": "J.A.R.V.I.S.",
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist"
    }
  }
}
