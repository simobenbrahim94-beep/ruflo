# ──────────────────────────────────────────────────────────────────────────────
# MBF Cosmetics — Video Generation API Keys
# Copy this file to .env at project root and fill in your keys.
# NEVER commit .env — it is already in .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# ── RUNWAY ML Gen-3 Alpha Turbo ───────────────────────────────────────────────
# Best for: liquid pours, skin texture closeups, cinematic product shots
# Free tier: 125 credits on signup (~500s of video)
# Signup: https://runwayml.com → Créer un compte → API → Create API Key
# Pricing: Standard $15/mo (625 credits), Pro $35/mo (2250 credits)
RUNWAY_API_KEY=

# ── ELEVENLABS ────────────────────────────────────────────────────────────────
# Best for: voix-off FR luxury (fr_female_luxury preset), Arabic/Darija
# Free tier: 10,000 characters/month — suffisant pour 1 spot 75s
# Signup: https://elevenlabs.io → Sign Up → Profile → API Keys
# Voice IDs used: EXAVITQu4vr4xnSDxMaL (Sarah, FR luxury)
ELEVENLABS_API_KEY=

# ── KLING AI (Kuaishou) ───────────────────────────────────────────────────────
# Best for: slow-motion product, trending format MENA/Europe, 5s-10s clips
# Free tier: plan gratuit disponible, ~30 crédits/mois
# Signup: https://klingai.com → Sign Up → API Access (waitlist ou direct)
# Note: API access may require business verification
KLING_API_KEY=

# ── STABILITY AI Ultra ────────────────────────────────────────────────────────
# Best for: key frames photorealistic, packshots produit, skin close-ups
# Free tier: crédits offerts à l'inscription
# Signup: https://stability.ai → Sign Up → API Keys → Create Key
# Model: stable-image/generate/ultra (endpoint used in apis.js)
STABILITY_API_KEY=

# ── HEYGEN (Avatar presenter) ─────────────────────────────────────────────────
# Best for: présentateur IA speaking French/Arabic, ambassador format
# Free tier: 1 crédit/mois (1 vidéo courte)
# Signup: https://heygen.com → Sign Up → Settings → API
HEYGEN_API_KEY=

# ── PIKA LABS ─────────────────────────────────────────────────────────────────
# Best for: product demo loops, packaging animations, trending TikTok format
# Free tier: plan gratuit (limited generations)
# Signup: https://pika.art → Sign Up → API (beta access)
# Note: API access is in beta, may require waitlist
PIKA_API_KEY=

# ── MOCK MODE (zero cost, for testing) ────────────────────────────────────────
# Set to 1 to use local cinematic renderer (Sharp + FFmpeg, no API needed)
# Produces real 1080x1920 H.264 video with 8 scenes and xfade transitions
# USE_MOCK_APIS=1

# ──────────────────────────────────────────────────────────────────────────────
# SCENE → API ROUTING (automatic when keys are set)
# Scene 1  Hook/arabesque     → STABILITY (key frame) + RUNWAY (animate)
# Scene 2  Promesse           → RUNWAY (liquid gold)
# Scene 3  Science/94%        → STABILITY (packshot)
# Scene 4  Régénère           → KLING (slow-motion skin)
# Scene 5  Illumine           → RUNWAY (light burst)
# Scene 6  Rituel             → KLING (hands + serum slow-mo)
# Scene 7  Transformation     → STABILITY (before/after frames)
# Scene 8  Finale/CTA         → STABILITY + overlay
# Voice-off                   → ELEVENLABS fr_female_luxury (74s narration)
# ──────────────────────────────────────────────────────────────────────────────
